# Copy to .env (never commit .env). Node reads it with: node --env-file=.env src/server.ts
PORT=8787

# Which Care Intelligence provider answers POST /api/care: "mock" (no key) or "openai".
CARE_PROVIDER=mock

# OpenAI (CARE_PROVIDER=openai). The key lives here on the server, never in the iOS app.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
# CARE_PROVIDER_TIMEOUT_MS=20000

# Voice: ElevenLabs is used ONLY for speech-to-text (Scribe v2 Realtime) and text-to-speech.
# "off" (default), "mock" (fake token + silent audio) or "elevenlabs".
VOICE_PROVIDER=off
# ELEVENLABS_API_KEY=            # server only; the app gets single-use tokens and streamed audio
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Client authentication. When set, every /api/* route except /api/health needs
# "Authorization: Bearer <LOFER_CLIENT_KEY>" (the app reads the same value from its scheme).
# Required when VOICE_PROVIDER=elevenlabs. Generate one with:  openssl rand -hex 32
# LOFER_CLIENT_KEY=

# Where to listen. 127.0.0.1 = this Mac only (simulator). 0.0.0.0 = also phones on your Wi-Fi.
# HOST=127.0.0.1

# Rate limits (defaults shown).
# RATE_LIMIT_CARE_PER_MINUTE=30
# RATE_LIMIT_VOICE_TOKENS_PER_MINUTE=6
# RATE_LIMIT_SPEECH_PER_MINUTE=40
# SPEECH_CHARACTERS_PER_DAY=50000
